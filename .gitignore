# ---- data (too large / reproducible from data_manifest.txt) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---- model artifacts (reproducible by running the training scripts) ----
# Only the registry CSV is versioned; it records which model produced which numbers.
trained_models/*
!trained_models/model_registry.csv
!trained_models/.gitkeep

# ---- experiment tracking (MLflow: sqlite run DB + artifact folder) ----
mlruns/
mlflow.db
mlartifacts/

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
venv/
.venv/

# ---- notebooks ----
.ipynb_checkpoints/

# ---- local / secrets / editor ----
.env
.commandcode
.vscode/
.idea/
*.log

# ---- private notes (full unredacted handoff stays local) ----
docs/HANDOFF_private.md

# ---- Optuna study storage (re-creatable by re-running the search) ----
optuna.db
